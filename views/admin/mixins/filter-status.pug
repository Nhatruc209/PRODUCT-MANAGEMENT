mixin filter-status(filterStatus)
    - const statusLabelMap = { "": "Tất cả", active: "Hoạt động", inactive: "Dừng hoạt động" }
    .admin-status-filter
        each item in filterStatus
            button(
                type="button"
                class=`admin-filter-chip ${item.class}`
                button-status=item.status
            ) #{statusLabelMap[item.status] || item.name}
