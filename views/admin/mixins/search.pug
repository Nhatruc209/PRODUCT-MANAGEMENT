mixin search(keyword)
    form.admin-search-form(id="form-search")
        span(aria-hidden="true") ⌕
        input(
            type="text"
            placeholder="Nhập từ khóa"
            name="keyword"
            class="form-control"
            value=keyword
        )
        button(
            class="btn admin-btn-primary"
            type="submit"
        ) Tìm
