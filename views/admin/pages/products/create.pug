extends ../../layouts/default.pug

block main
    .admin-page-head
        div
            span.admin-page-kicker Product Studio
            h1.admin-page-title Thêm sản phẩm
            p.admin-page-desc Tạo sản phẩm mới cho bộ sưu tập Sera.
        a.btn.admin-btn-soft(href=`${prefixAdmin}/products`) Quay lại

    .admin-form-card
        form(action=`${prefixAdmin}/products/create` method="POST" enctype="multipart/form-data")
            .form-group
                label(for="title") Tiêu đề sản phẩm
                input#title.form-control(type="text" name="title" required)

            .form-group
                label(for="description") Mô tả
                textarea#description.form-control(name="description" rows="6")

            .form-row
                .form-group.col-md-4
                    label(for="price") Giá (VNĐ)
                    input#price.form-control(type="number" name="price" min="0" value="0")
                .form-group.col-md-4
                    label(for="discountPercentage") Phần trăm giảm giá
                    input#discountPercentage.form-control(type="number" name="discountPercentage" min="0" max="100" value="0")
                .form-group.col-md-4
                    label(for="stock") Số lượng tồn kho
                    input#stock.form-control(type="number" name="stock" min="0" value="0")

            .form-row
                .form-group.col-md-4
                    label(for="categoryId") Danh mục
                    select#categoryId.form-control(name="categoryId")
                        option(value="") Chưa phân loại
                        each item in categories
                            option(value=item._id) #{item.title}
                .form-group.col-md-4
                    label(for="status") Trạng thái
                    select#status.form-control(name="status")
                        option(value="active" selected) Hoạt động
                        option(value="inactive") Dừng hoạt động
                .form-group.col-md-4
                    label(for="position") Vị trí
                    input#position.form-control(type="number" name="position" min="1" placeholder="Bỏ trống = tự động")

            .form-group
                label(for="thumbnail") Ảnh đại diện
                input#thumbnail.form-control(type="file" name="thumbnail" accept="image/*")

            .admin-action-group
                button.btn.admin-btn-primary(type="submit") Thêm mới
                a.btn.admin-btn-soft(href=`${prefixAdmin}/products`) Hủy
