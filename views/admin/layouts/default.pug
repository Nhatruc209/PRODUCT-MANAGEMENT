doctype html
html
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title #{pageTitle}
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="/admin/css/layout.css")
        link(rel="stylesheet", href="/admin/css/sidebar.css")
        if cssFile
            link(rel="stylesheet", href=cssFile)

    body.admin-shell
        include ../partials/sider.pug

        .admin-content
            include ../partials/header.pug

            main.admin-main
                if messages.success
                    each message in messages.success
                        .alert.alert-success.alert-dismissible.fade.show(message-alert role="alert")
                            | #{message}
                            button.close(type="button" data-dismiss="alert" aria-label="Close")
                                span(aria-hidden="true") &times;

                if messages.error
                    each message in messages.error
                        .alert.alert-danger.alert-dismissible.fade.show(message-alert role="alert")
                            | #{message}
                            button.close(type="button" data-dismiss="alert" aria-label="Close")
                                span(aria-hidden="true") &times;

                block main

        include ../partials/footer.pug

        script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js")
        script(src="/admin/js/admin.js")
